{
  "name": "arraypress/wp-register-setting-fields",
  "description": "Lightweight library for registering WordPress settings pages with fields using the Settings API, featuring tabs, conditional field visibility, repeaters, and REST API integration.",
  "homepage": "https://github.com/arraypress/wp-register-setting-fields/",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "arraypress/wp-composer-assets": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RegisterSettingFields\\": "src/"
    },
    "files": [
      "src/Utilities/Core.php",
      "src/Utilities/Email.php",
      "src/Utilities/Page.php",
      "src/Utilities/TypeCheck.php",
      "src/Utilities/License.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-register-setting-fields/issues",
    "source": "https://github.com/arraypress/wp-register-setting-fields"
  },
  "keywords": [
    "wordpress",
    "settings",
    "options",
    "admin",
    "tabs",
    "repeater",
    "gallery",
    "conditional-logic",
    "show-when"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\RegisterSettingFields\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  }
}
