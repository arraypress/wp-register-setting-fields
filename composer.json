{
  "name": "arraypress/wp-register-setting-fields",
  "description": "Registers a tabbed WordPress settings page from a field configuration, rendered by wp-field-kit.",
  "homepage": "https://github.com/arraypress/wp-register-setting-fields/",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "arraypress/wp-field-kit": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RegisterSettingFields\\": "src/"
    },
    "files": [
      "src/Core.php",
      "src/Email.php",
      "src/License.php",
      "src/Page.php",
      "src/TypeCheck.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": {
      "arraypress/wp-field-kit": "source",
      "*": "dist"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-register-setting-fields/issues",
    "source": "https://github.com/arraypress/wp-register-setting-fields"
  },
  "keywords": [
    "wordpress",
    "settings",
    "options",
    "admin",
    "tabs",
    "repeater",
    "gallery",
    "conditional-logic",
    "show-when"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\RegisterSettingFields\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "docs:verify": "php vendor/arraypress/wp-field-kit/bin/verify-docs.php --calls=register_setting_fields,register_settings README.md"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/arraypress/wp-field-kit.git"
    }
  ]
}
