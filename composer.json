{
  "name": "arraypress/wp-register-setting-fields",
  "version": "1.0.0",
  "description": "Lightweight library for registering WordPress settings pages with fields using the Settings API, featuring tabs, conditional field visibility, repeaters, and REST API integration.",
  "homepage": "https://github.com/arraypress/wp-register-setting-fields/",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=7.4",
    "arraypress/wp-composer-assets": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RegisterSettingFields\\": "src/"
    },
    "files": [
      "src/Utilities/Core.php",
      "src/Utilities/Email.php",
      "src/Utilities/Page.php",
      "src/Utilities/TypeCheck.php"
    ]
  },
  "scripts": {
    "get-select2": [
      "@php -r \"file_put_contents('assets/js/select2.min.js', file_get_contents('https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js')); echo 'Downloaded select2.min.js' . PHP_EOL;\"",
      "@php -r \"file_put_contents('assets/css/select2.min.css', file_get_contents('https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css')); echo 'Downloaded select2.min.css' . PHP_EOL;\""
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-register-setting-fields/issues",
    "source": "https://github.com/arraypress/wp-register-setting-fields"
  },
  "keywords": [
    "wordpress",
    "settings",
    "options",
    "admin",
    "tabs",
    "repeater",
    "gallery",
    "conditional-logic",
    "show-when"
  ]
}
